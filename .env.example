# Ollama remains the default provider.
INFERENCE_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api/chat
INFERENCE_CONNECT_TIMEOUT=5
INFERENCE_READ_TIMEOUT=120
OLLAMA_MODEL_MAP={"general":"mistral","coding":"qwen2.5:3b","summarization":"gemma2:2b","fast":"phi3:mini"}

# To use a separately deployed vLLM server, set INFERENCE_PROVIDER to
# openai_compatible and configure its server-visible model IDs.
OPENAI_COMPATIBLE_BASE_URL=http://vllm.example:8000/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CONNECT_TIMEOUT=5
OPENAI_COMPATIBLE_READ_TIMEOUT=120
OPENAI_COMPATIBLE_MODEL_MAP={"general":"gpt-oss-20b","coding":"gpt-oss-20b","summarization":"gpt-oss-20b","fast":"gpt-oss-20b"}
OPENAI_COMPATIBLE_GENERATION_PARAMETERS={"temperature":0.2}
PROVIDER_READINESS_TIMEOUT=3
PROVIDER_READINESS_RETRIES=1
PROVIDER_READINESS_BACKOFF=0.1

API_HOST=127.0.0.1
API_PORT=8001
API_URL=http://127.0.0.1:8001/query
STREAM_URL=http://127.0.0.1:8001/query/stream
REQUEST_TIMEOUT=120

# chroma_local is development/single-replica only. Use chroma_http for replicas.
VECTOR_STORE_PROVIDER=chroma_local
CHROMA_PATH=./chroma_db
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=8000
VECTOR_STORE_SSL=false
VECTOR_STORE_COLLECTION=knowledge_base
RETRIEVAL_TOP_K=5
RERANK_TOP_K=3
MEMORY_HISTORY=6
# The file backend is for local development/single-host use. Use redis for replicas.
MEMORY_PROVIDER=file
MEMORY_FILE=memory/chat_history.json
REDIS_URL=redis://localhost:6379/0
MEMORY_CONNECT_TIMEOUT=2
MEMORY_OPERATION_TIMEOUT=2
# Zero disables expiry; positive values are idle-session TTL seconds.
MEMORY_TTL=0

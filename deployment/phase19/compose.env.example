# Inert placeholders. Configuration parsing is safe; startup needs real private mounts.
PHASE19_APP_IMAGE=polymind:phase19-reviewed
PHASE19_STATE_ROOT=/srv/polymind/operator
PHASE19_REDIS_ROOT=/srv/polymind/redis
PHASE19_CHROMA_ROOT=/srv/polymind/chroma
PHASE19_PROVIDER_SECRET=/etc/polymind/secrets/provider
PHASE19_STREAMLIT_SECRET=/etc/polymind/secrets/streamlit.toml
PHASE19_TLS_CERT=/etc/polymind/secrets/tls.crt
PHASE19_TLS_KEY=/etc/polymind/secrets/tls.key
PHASE19_ORIGIN=https://polymind.private.example:9443
PHASE19_EXECUTION_AUTHORITY=/etc/polymind/execution-authority
